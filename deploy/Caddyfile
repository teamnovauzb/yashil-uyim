# Standalone host only. Preserve the shared server's existing Nginx; see deploy/hetzner/.
{$APP_DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    # Scanner may request the camera only from this application's origin.
    Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  }
  @api path /api/*
  handle @api {
    reverse_proxy api:3001
  }
  handle {
    root * /srv
    try_files {path} /index.html
    @shell path / /index.html
    header @shell Cache-Control "no-store"
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  # Request logs are intentionally disabled: signed media URLs are private credentials.
}
