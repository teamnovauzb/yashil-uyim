NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_URL=http://127.0.0.1:4173
ALLOWED_ORIGINS=http://127.0.0.1:4173,https://localhost,capacitor://localhost
DATABASE_URL=postgresql://yashiluyim:REPLACE_PASSWORD@127.0.0.1:5432/yashiluyim
APP_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
BOT_TOKEN=REPLACE_WITH_A_SEPARATE_TEST_BOT_TOKEN
BOT_USERNAME=YashilUyimTestBot
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
UPLOAD_DIR=./uploads
BOOTSTRAP_SUPER_ADMIN_IDS=
# Worker defaults to paused. OTP replies only occur after an authenticated test webhook.
ENABLE_TELEGRAM_DELIVERY=false
# Migration commands do not fall back to DATABASE_URL and require these explicitly.
MIGRATION_TARGET_URL=
SOURCE_DATABASE_URL=
SOURCE_SUPABASE_URL=
SOURCE_STORAGE_KEY=
SNAPSHOT_DIR=./backups/migration
