# Copy to .env.public.local in the isolated checkout before a future public mobile build.
# Use the permanent guest gateway domain for Supabase now -> VPS later without a binary update.
# No Supabase key or login credential belongs here. See docs/PUBLIC_DATA_SWITCH.md.
VITE_PUBLIC_API_URL=https://SET_THE_GUEST_API_DOMAIN
# Publisher-approved policy page; required before store submission.
VITE_PUBLIC_PRIVACY_URL=
