# Legacy deployments still use their existing environment. Do not copy live .env into the preparation worktree.
# VPS mode is opt-in via npm run dev:vps / npm run build:vps.
VITE_BACKEND=vps
# Empty for the website served alongside the API. Required HTTPS origin for native builds.
VITE_API_URL=
VPS_DEV_PROXY=http://127.0.0.1:3001
