# Root-only file for explicit migration/import commands. Never load into API/worker services.
MIGRATION_TARGET_URL=postgresql://yashiluyim_migrator:REPLACE_WITH_64_HEX_MIGRATOR_PASSWORD@127.0.0.1:5432/yashiluyim
YASHILUYIM_MIGRATOR_PASSWORD=REPLACE_WITH_64_HEX_MIGRATOR_PASSWORD
YASHILUYIM_APP_PASSWORD=REPLACE_WITH_INDEPENDENT_64_HEX_APP_PASSWORD
UPLOAD_DIR=/var/lib/yashiluyim/uploads
SNAPSHOT_DIR=/var/lib/yashiluyim/import
BOOTSTRAP_SUPER_ADMIN_IDS=
# Source credentials are supplied only during an authorized export, never in runtime services.
