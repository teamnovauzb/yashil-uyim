APP_DOMAIN=festival.example.com
PUBLIC_URL=https://festival.example.com
ALLOWED_ORIGINS=https://festival.example.com,https://localhost,capacitor://localhost
# Generate each secret independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use hex for DB_PASSWORD so it remains safe in the database connection URL.
