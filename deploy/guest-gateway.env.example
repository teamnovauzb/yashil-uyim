# Private server-side environment for a SEPARATE public gateway. Never bundle into the app.
# Host this behind HTTPS before store submission; the mobile binary keeps this origin forever.
GUEST_API_ORIGIN=https://SET_THE_STABLE_GUEST_DOMAIN
GUEST_HOST=127.0.0.1
GUEST_PORT=3002
GUEST_ALLOWED_ORIGINS=https://localhost,capacitor://localhost,https://SET_THE_STABLE_GUEST_DOMAIN

# Initial source: the current Mini App's published Supabase content (GET requests only).
PUBLIC_CONTENT_SOURCE=supabase
GUEST_SUPABASE_URL=https://SET_THE_CURRENT_SUPABASE_PROJECT
GUEST_SUPABASE_PUBLIC_KEY=

# Later, after migrating and verifying data/media, change the source and restart the gateway.
# Keep GUEST_API_ORIGIN and the mobile app's VITE_PUBLIC_API_URL unchanged.
# PUBLIC_CONTENT_SOURCE=vps
# GUEST_VPS_ORIGIN=https://SET_THE_VPS_UPSTREAM_DOMAIN
