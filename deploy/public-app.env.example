# Copy to .env.public.local in the isolated checkout before a future public mobile build.
# Selected first release: current public Supabase data directly; later VPS needs a new binary.
VITE_PUBLIC_CONTENT_SOURCE=supabase
VITE_PUBLIC_SUPABASE_URL=https://SET_THE_CURRENT_SUPABASE_PROJECT
# Only a publishable/anon key; never a secret or service-role key.
VITE_PUBLIC_SUPABASE_KEY=
# Alternative for a future gateway/VPS build: set source=api and its HTTPS origin below.
VITE_PUBLIC_API_URL=
# Publisher-approved policy page; required before store submission.
VITE_PUBLIC_PRIVACY_URL=
