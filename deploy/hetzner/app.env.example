# Native profile for the existing Nginx + PostgreSQL 18 host.
# Install privately at /etc/yashiluyim/app.env; never reuse the current Mini App's env file.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
PUBLIC_URL=https://SET_THE_NEW_DOMAIN
ALLOWED_ORIGINS=https://SET_THE_NEW_DOMAIN,https://localhost,capacitor://localhost
DATABASE_URL=postgresql://yashiluyim_app:REPLACE_WITH_64_HEX_APP_PASSWORD@127.0.0.1:5432/yashiluyim
APP_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_INDEPENDENT_64_HEX_CHARACTERS
BOT_TOKEN=REPLACE_WITH_SEPARATE_TEST_BOT_TOKEN_INITIALLY
BOT_USERNAME=YashilUyimTestBot
UPLOAD_DIR=/var/lib/yashiluyim/uploads
ENABLE_TELEGRAM_DELIVERY=false
